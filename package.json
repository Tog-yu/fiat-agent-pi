{
	"name": "fiat-agent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "法币业务内部 Agent 系统，基于 Pi Agent Runtime（不改 Pi 核心）",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "biome check . && tsgo --noEmit",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check --write .",
		"test": "vitest --run",
		"cli": "node --experimental-strip-types src/server/cli/entry.ts",
		"dev:pi-local": "node scripts/switch-pi-deps.mjs local && npm install --ignore-scripts --legacy-peer-deps",
		"dev:pi-registry": "node scripts/switch-pi-deps.mjs registry && npm install --ignore-scripts --legacy-peer-deps"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.80.3",
		"@earendil-works/pi-ai": "0.80.3",
		"@earendil-works/pi-coding-agent": "0.80.3",
		"@earendil-works/pi-tui": "0.80.3",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
